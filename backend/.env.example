JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGINS=http://localhost:3000
PORT=8080
DATABASE_PATH=./data/kerjaqueue.db
NODE_ENV=development

# Google: Web Client ID dari Google Cloud Console (OAuth 2.0 Client ID, tipe Web).
# Kosongkan bila belum siap; login email + kata sandi tetap berjalan.
GOOGLE_CLIENT_ID=

# Z.ai: kunci baru yang sudah dirotasi. Jangan pakai kunci yang pernah bocor.
# Isi lewat environment server / secrets manager, jangan commit file .env.
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash

# Akun demo dibuat saat database masih kosong. Kosongkan untuk menonaktifkan.
DEMO_PASSWORD=replace-with-a-local-demo-password
SEED=true
